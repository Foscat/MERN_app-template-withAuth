{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/seo/build.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"playwright/**/*.js\" \"*.{js,mjs,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"playwright/**/*.js\" \"*.{js,mjs,json,md,html}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test -c playwright.config.js app.smoke.spec.js",
    "test:snapshots": "playwright test -c playwright.config.js --update-snapshots",
    "test:snapshots:verify": "playwright test -c playwright.config.js",
    "test:snapshots:update": "playwright test -c playwright.config.js --update-snapshots"
  },
  "dependencies": {
    "axios": "1.20.0",
    "interactive-surface-css": "1.7.3",
    "layout-style-css": "3.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "ui-style-kit-css": "2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
