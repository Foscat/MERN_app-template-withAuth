{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/seo/build.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"playwright/**/*.js\" \"*.{js,mjs,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"playwright/**/*.js\" \"*.{js,mjs,json,md,html}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test -c playwright.config.js app.smoke.spec.js",
    "test:snapshots": "playwright test -c playwright.config.js --update-snapshots",
    "test:snapshots:verify": "playwright test -c playwright.config.js",
    "test:snapshots:update": "playwright test -c playwright.config.js --update-snapshots"
  },
  "dependencies": {
    "axios": "1.21.1",
    "interactive-surface-css": "1.7.3",
    "layout-style-css": "3.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "ui-style-kit-css": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
