# Runtime
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost/mern_app-template-withauth
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=100kb

# Authentication
JWT_ACCESS_SECRET=replace-with-a-unique-random-access-secret-of-32-or-more-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-of-32-or-more-characters
JWT_ISSUER=mern-app-template
JWT_AUDIENCE=mern-app-client
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_MAX_AGE_MS=604800000
BCRYPT_ROUNDS=12

# Guarded one-time administrator promotion command
ADMIN_EMAIL=
ALLOW_ADMIN_PROMOTION=false
