# Development defaults let the app run immediately after dependency installation.
# IMPORTANT: Review and replace every value that identifies infrastructure,
# credentials, origins, or administrator access before deploying to production.

# Runtime
NODE_ENV=development
DEPLOYMENT_MODE=single
PORT=3001
MONGODB_URI=mongodb://localhost/mern_app-template-withauth
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=100kb
MONGO_MAX_POOL_SIZE=10
DEPENDENCY_TIMEOUT_MS=5000
QUERY_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=15000

# Rate limiting (use redis plus one shared URL for multi-instance deployments)
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_PREFIX=mern-app-template-development-rate-limit

# Authentication
JWT_ACCESS_SECRET=development-only-access-secret-never-use-in-production
JWT_REFRESH_SECRET=development-only-refresh-secret-never-use-in-production
JWT_ISSUER=mern-app-template
JWT_AUDIENCE=mern-app-client
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_MAX_AGE_MS=604800000
BCRYPT_ROUNDS=12

# Guarded one-time administrator promotion command
ADMIN_EMAIL=admin@example.local
ALLOW_ADMIN_PROMOTION=false
