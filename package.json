{
  "name": "mern_app-template-withauth-modern",
  "version": "1.3.0",
  "description": "Modern MERN app template with JWT auth, role support, and a configurable semantic UI frontend",
  "private": true,
  "main": "app/server/server.js",
  "scripts": {
    "start": "npm run dev",
    "start:prod": "node app/server/server.js",
    "doctor": "node scripts/dev/doctor.mjs",
    "scaffold": "node scripts/dev/scaffold.mjs",
    "test:multi-instance": "node --test scripts/integration/multi-instance.test.mjs",
    "test:seo": "node --test shared/seo/seo.test.mjs scripts/seo/build.test.mjs",
    "load:local": "node scripts/performance/load.mjs",
    "db:indexes": "node scripts/database/indexes.mjs",
    "dev": "concurrently \"nodemon --ignore 'client/*'\" \"npm run client\"",
    "start:dev": "npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "heroku-postbuild": "npm run build",
    "admin:promote": "node scripts/admin/promote-user.mjs",
    "docs:generate": "node scripts/docs/generate-docs.mjs",
    "docs:check": "node scripts/docs/generate-docs.mjs --check",
    "docs:test": "node --test scripts/docs/generate-docs.test.mjs",
    "docs:api": "npm run docs:generate",
    "docs:client": "npm run docs:generate",
    "docs:all": "npm run docs:generate",
    "lint": "eslint app scripts shared",
    "format": "prettier --write \"app/**/*.js\" \"scripts/**/*.mjs\" \"*.{cjs,json,md,mjs}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"app/**/*.js\" \"scripts/**/*.mjs\" \"*.{cjs,json,md,mjs}\" \".github/**/*.{yml,yaml}\"",
    "test:server": "node --test \"app/**/*.test.js\"",
    "test:admin": "node --test scripts/admin/promote-user.test.mjs",
    "test:source": "node --test scripts/quality/source-policy.test.mjs",
    "test:unit": "npm --prefix client run test:unit",
    "test:snapshots": "npm --prefix client run test:snapshots",
    "test:snapshots:verify": "npm --prefix client run test:snapshots:verify",
    "test:snapshots:update": "npm --prefix client run test:snapshots:update",
    "audit:prod": "npm audit --omit=dev --audit-level=high && npm --prefix client audit --omit=dev --audit-level=high",
    "verify:ci": "npm run docs:test && npm run docs:check && npm run format:check && npm run lint && npm run test:server && npm run test:admin && npm run test:source && npm --prefix client run format:check && npm --prefix client run lint && npm run test:unit && npm run build && npm run audit:prod"
  },
  "author": "Foscat",
  "license": "ISC",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.0",
    "rate-limit-redis": "6.0.1",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdoc-to-markdown": "9.1.3",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "supertest": "7.2.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
